{
  "name": "solophp/logger",
  "type": "library",
  "description": "PSR-3 logger with coordinated file rotation and line, JSON or logfmt output",
  "keywords": ["php", "logger", "logging", "psr-3", "psr-20", "log rotation", "json", "ndjson", "logfmt"],
  "license": "MIT",
  "authors": [
    {
      "name": "Vitaliy Olos",
      "email": "vedastudio@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Solo\\Logger\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Solo\\Logger\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.3",
    "psr/log": "^3.0",
    "psr/clock": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^3.13",
    "phpstan/phpstan": "^2.0"
  },
  "scripts": {
    "test": "phpunit",
    "test-coverage": "phpunit --coverage-html coverage",
    "analyze": "phpstan analyze",
    "cs": "phpcs --standard=PSR12 src/ tests/",
    "cs-fix": "phpcbf --standard=PSR12 src/ tests/",
    "check": [
      "@cs",
      "@analyze",
      "@test"
    ]
  },
  "provide": {
    "psr/log-implementation": "3.0"
  },
  "config": {
    "platform": {
      "php": "8.3.0"
    },
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
